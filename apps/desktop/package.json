{
  "name": "desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Electron 桌面壳：开发态加载 Next dev server，生产态托管静态导出（Forge 8）",
  "license": "MIT",
  "engines": {
    "node": ">=26.12.1"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "dev": "electron-forge start",
    "build": "node scripts/copy-renderer.mjs",
    "package": "node scripts/copy-renderer.mjs && electron-forge package",
    "make": "node scripts/copy-renderer.mjs && electron-forge make",
    "check-types": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --no-error-on-unmatched-pattern",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt ."
  },
  "devDependencies": {
    "@electron-forge/cli": "catalog:desktop",
    "@electron-forge/maker-zip": "catalog:desktop",
    "@electron-forge/plugin-fuses": "catalog:desktop",
    "@electron-forge/plugin-vite": "catalog:desktop",
    "@electron-forge/shared-types": "catalog:desktop",
    "@electron/fuses": "catalog:desktop",
    "@types/node": "catalog:desktop",
    "@vitest/coverage-v8": "catalog:testing",
    "@workspace/types": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "electron": "catalog:desktop",
    "typescript": "catalog:tooling",
    "vite": "catalog:tooling",
    "vitest": "catalog:testing"
  }
}
