{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "__tests__/**/*.ts",
    "forge.config.ts",
    "vite.*.config.mts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", ".vite", "renderer", "out"]
}
