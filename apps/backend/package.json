{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS 12 本地领域服务骨架（5000）",
  "license": "MIT",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "check-types": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --no-error-on-unmatched-pattern",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "start": "nest start",
    "start:prod": "node dist/main"
  },
  "dependencies": {
    "@nestjs/common": "catalog:backend",
    "@nestjs/core": "catalog:backend",
    "@nestjs/platform-express": "catalog:backend",
    "reflect-metadata": "catalog:backend",
    "rxjs": "catalog:backend"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:backend",
    "@nestjs/schematics": "catalog:backend",
    "@nestjs/testing": "catalog:backend",
    "@types/express": "catalog:backend",
    "@types/node": "catalog:tooling",
    "@vitest/coverage-v8": "catalog:testing",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "typescript": "catalog:tooling",
    "vite": "catalog:tooling",
    "vitest": "catalog:testing"
  }
}
