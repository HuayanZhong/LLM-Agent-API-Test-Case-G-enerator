{
  "name": "LLM-Agent-API-Test-Case-G-enerator",
  "version": "0.0.0",
  "private": true,
  "description": "基于大模型智能体的接口测试用例辅助生成系统的设计与实现 (Design and Implementation of an LLM-Agent-Assisted API Test Case Generation System)",
  "keywords": [
    "llm-agent",
    "api-testing",
    "test-case-generation",
    "graphrag",
    "a2a",
    "thesis"
  ],
  "author": "huayan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/HuayanZhong/LLM-Agent-API-Test-Case-G-enerator.git"
  },
  "bugs": {
    "url": "https://github.com/HuayanZhong/LLM-Agent-API-Test-Case-G-enerator/issues"
  },
  "homepage": "https://github.com/HuayanZhong/LLM-Agent-API-Test-Case-G-enerator#readme",
  "type": "module",
  "engines": {
    "node": ">=26.12.1",
    "pnpm": ">=12.18.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.development node_modules/turbo/bin/turbo run dev",
    "build": "node --env-file-if-exists=.env --env-file-if-exists=.env.production node_modules/turbo/bin/turbo run build",
    "check-types": "turbo run check-types",
    "test": "node --env-file-if-exists=.env --env-file-if-exists=.env.development node_modules/turbo/bin/turbo run test",
    "test:watch": "node --env-file-if-exists=.env --env-file-if-exists=.env.development node_modules/turbo/bin/turbo run test:watch",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:fix": "turbo run format:fix",
    "format:root": "oxfmt --check package.json pnpm-workspace.yaml turbo.json .oxlintrc.json .oxfmtrc.json .mcp.json skills-lock.json .github renovate.json",
    "format:root:fix": "oxfmt package.json pnpm-workspace.yaml turbo.json .oxlintrc.json .oxfmtrc.json .mcp.json skills-lock.json .github renovate.json"
  },
  "devDependencies": {
    "@fission-ai/openspec": "catalog:tooling",
    "oxfmt": "catalog:tooling",
    "oxlint": "catalog:tooling",
    "turbo": "catalog:tooling"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0"
}
