{
  "name": "@workspace/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "共享 shadcn 组件、cn() 与 Tailwind v4 样式",
  "license": "MIT",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --no-error-on-unmatched-pattern",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "class-variance-authority": "catalog:frontend",
    "cn": "catalog:frontend",
    "lucide-react": "catalog:frontend",
    "radix-ui": "catalog:frontend",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "catalog:storybook",
    "@storybook/addon-docs": "catalog:storybook",
    "@storybook/addon-mcp": "catalog:storybook",
    "@storybook/addon-themes": "catalog:storybook",
    "@storybook/react-vite": "catalog:storybook",
    "@tailwindcss/postcss": "catalog:frontend",
    "@testing-library/dom": "catalog:testing",
    "@testing-library/jest-dom": "catalog:testing",
    "@testing-library/react": "catalog:testing",
    "@types/node": "catalog:tooling",
    "@types/react": "catalog:frontend",
    "@types/react-dom": "catalog:frontend",
    "@vitejs/plugin-react": "catalog:testing",
    "@vitest/coverage-v8": "catalog:testing",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "jsdom": "catalog:testing",
    "shadcn": "catalog:tooling",
    "storybook": "catalog:storybook",
    "tailwindcss": "catalog:frontend",
    "tw-animate-css": "catalog:frontend",
    "typescript": "catalog:tooling",
    "vite": "catalog:tooling",
    "vitest": "catalog:testing"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  }
}
