{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    // 消费方是 Next / Vite 这类 bundler，Bundler 解析允许直接 import JSON 文案。
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "noEmit": true
  },
  "include": ["src", "__tests__", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
