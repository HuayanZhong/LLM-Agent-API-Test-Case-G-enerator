{
  "name": "@workspace/config",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "跨应用共享的环境变量解析与校验（运行时工具，无构建）",
  "license": "MIT",
  "engines": {
    "node": ">=26.12.1"
  },
  "exports": {
    ".": "./src/env.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --no-error-on-unmatched-pattern",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt ."
  },
  "dependencies": {
    "zod": "catalog:backend"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:testing",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "typescript": "catalog:tooling",
    "vite": "catalog:tooling",
    "vitest": "catalog:testing"
  }
}
