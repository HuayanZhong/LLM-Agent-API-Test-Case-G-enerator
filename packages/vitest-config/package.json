{
  "name": "@workspace/vitest-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Vitest configuration profiles for the workspace",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --no-error-on-unmatched-pattern",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt ."
  },
  "devDependencies": {
    "@workspace/typescript-config": "workspace:*",
    "typescript": "catalog:tooling",
    "vitest": "catalog:testing"
  }
}
