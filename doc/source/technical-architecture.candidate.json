  "cards": [
    {
      "dot": "cyan",
      "title": "桌面端与本地进程",
      "items": [
        "Electron 主进程管理窗口、密钥与本地进程；渲染进程只跑界面",
        "Next.js 以 standalone server 运行，BFF 只做会话、SSE 与聚合",
        "NestJS 与 MCP 进程由主进程拉起；启动顺序、端口、优雅退出要统一"
      ]
    },
    {
      "dot": "violet",
      "title": "编排与契约",
      "items": [
        "LangGraph.js 负责状态图、检查点、重试与人工介入；LangChain.js 负责模型适配与工具调用",
        "Case IR、执行结果、报告统一用 Zod 定义；解析失败重试，不合法拒收",
        "Deep Agents 只作可选增强：Node 生态若无可用版本，用 LangGraph.js 复刻或加 Python sidecar"
      ]
    },
    {
      "dot": "amber",
      "title": "数据与知识",
      "items": [
        "MikroORM 管业务表与迁移；pgvector 自定义类型与 HNSW 索引走 SQL 迁移",
        "GraphRAG 检索服务负责切片、向量化、图检索与重排；邻接表 + pgvector 都落在 Supabase",
        "Postgres 存业务表、JSONB、图邻接表；Storage 存报告、证据与 OKF 文档",
        "Embedding 模型与维度要先定；OKF 用 sources / verified / stale_after 管生命周期"
      ]
    },
    {
      "dot": "rose",
      "title": "执行与安全",
      "items": [
        "ky + Vitest 负责批量执行与断言；chrome-devtools MCP 只负责采集",
        "被测地址白名单，禁内网与元数据地址；写操作只在测试环境并清理",
        "提示词注入与页面内容不可信：工具白名单、输出校验、密钥只放主进程/NestJS",
        "A2A 回执到本地需隧道或轮询；长任务用队列 + 超时重试"
      ]
    },
    {
      "dot": "slate",
      "title": "运行时与治理",
      "items": [
        "LangGraph 检查点落 Postgres；任务队列 + Worker 承担长任务与并发上限",
        "模型网关做供应商切换、降级、限流与 token 预算；Prompt / 模型版本要可追溯",
        "日志、请求 ID、Agent 轨迹与 token 成本；黄金集评测幻觉断言率与通过率",
        "Electron 主进程管理 Next / NestJS / MCP 的启动顺序、端口与优雅退出"
      ]
    }
  ]
}