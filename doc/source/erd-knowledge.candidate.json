  "cards": [
    {
      "dot": "violet",
      "title": "知识与 OKF",
      "items": [
        "knowledge_nodes 存切片、来源与 embedding；knowledge_edges 存图邻接，供递归 CTE",
        "OKF 以 path 唯一；frontmatter 存 sources / verified / status / stale_after",
        "冲突条目标“待确认”，确认前旧条目不覆盖；停用不删除"
      ]
    },
    {
      "dot": "cyan",
      "title": "A2A 协同",
      "items": [
        "a2a_tasks 以 idempotency_key 去重，last_receipt 保留回执原文",
        "a2a_events 追加写，状态迁移可审计；timeout_at 驱动超时与重试",
        "报告只挂 report_id，不复制报告正文"
      ]
    },
    {
      "dot": "amber",
      "title": "治理",
      "items": [
        "audit_logs 记录谁在何时改了什么；entity_id 为多态引用",
        "prompt_versions 固定 Prompt、模型与状态，保证生成可追溯",
        "eval_runs 存黄金集指标：召回、准确率、幻觉断言率、token 成本"
      ]
    }
  ]
}