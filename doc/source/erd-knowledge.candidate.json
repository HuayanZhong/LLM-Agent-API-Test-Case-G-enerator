{
  "schema_version": 1,
  "diagram_type": "erd",
  "meta": {
    "title": "数据模型 · 知识与协同（GraphRAG、OKF、A2A、治理）",
    "output": "doc/erd-knowledge.html",
    "locale": "zh-CN",
    "quality_profile": "standard",
    "views": [
      {
        "id": "knowledge",
        "label": "知识与图谱",
        "focus": [
          "projects",
          "knowledge_nodes",
          "knowledge_edges"
        ],
        "note": "知识节点带 embedding 与来源；边是图检索的邻接关系"
      },
      {
        "id": "okf",
        "label": "OKF",
        "focus": [
          "projects",
          "okf_documents"
        ],
        "note": "OKF 以文档路径为唯一键，frontmatter 存来源、确认与过期"
      },
      {
        "id": "a2a",
        "label": "A2A 协同",
        "focus": [
          "reports",
          "a2a_tasks",
          "a2a_events"
        ],
        "note": "任务幂等键、回执原文与事件流水"
      },
      {
        "id": "governance",
        "label": "治理",
        "focus": [
          "audit_logs",
          "prompt_versions",
          "eval_runs"
        ],
        "note": "审计、Prompt/模型版本、评测记录"
      }
    ]
  },
